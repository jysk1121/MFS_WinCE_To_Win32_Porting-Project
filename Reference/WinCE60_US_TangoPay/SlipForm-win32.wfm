XFSFORM "ReceiptHeaderImage"
BEGIN
   UNIT ROWCOLUMN, 1, 1
   SIZE 40, 5
   LANGUAGE 1033

   XFSFIELD "Image"
   BEGIN
      POSITION 0, 0
      SIZE     40, 5
      TYPE     GRAPHIC
      HORIZONTAL CENTER
      VERTICAL   CENTER
      INITIALVALUE "C:\ReceiptHeader.bmp"
   END
END

XFSFORM "CouponImageBCD"
BEGIN
   UNIT ROWCOLUMN, 1, 1
   SIZE 40, 4
   LANGUAGE 1033

   XFSFIELD "Image"
   BEGIN
      POSITION 3, 0
      SIZE     34, 4
      TYPE     GRAPHIC
      HORIZONTAL CENTER
      VERTICAL   CENTER
      INITIALVALUE "\CouponImageBCD.bmp"
   END
END

XFSFORM "CouponImageQR"
BEGIN
   UNIT ROWCOLUMN, 1, 1
   SIZE 40, 6
   LANGUAGE 1033

   XFSFIELD "Image"
   BEGIN
      POSITION 15, 0
      SIZE     11, 6
      TYPE     GRAPHIC
      HORIZONTAL CENTER
      VERTICAL   CENTER
      INITIALVALUE "\CouponImageQR.bmp"
   END
END

XFSFORM "CouponImageLargeQR"
BEGIN
   UNIT ROWCOLUMN, 1, 1
   SIZE 40, 11
   LANGUAGE 1033

   XFSFIELD "Image"
   BEGIN
      POSITION 10, 0
      SIZE     20, 11
      TYPE     GRAPHIC
      HORIZONTAL CENTER
      VERTICAL   CENTER
      INITIALVALUE "\CouponImageQR.bmp"
   END
END

XFSMEDIA "ReceiptMedia"
BEGIN
UNIT      ROWCOLUMN, 1, 1
SIZE      40, 99
PRINTAREA 0, 0, 40, 99
END

