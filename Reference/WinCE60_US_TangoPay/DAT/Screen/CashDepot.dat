;///////////////////////////////
;       Remaining Balance
;           399 Screen
;///////////////////////////////
[Screen]
ID=399
Back=199900

; Line
[TextBox]
Picture=I_AP_TOP_LINE
Pos=POS_TopLine
[/TextBox]

; Title
[TextBox]
Pos=POS_Title
Font=F_ApTitle
Outline=1,C_ApOutline
Name=APValue2
TextSet=0,LEFT,C_ApTitle
Icon=I_AP_ICON_QUESTION,64,64
[/TextBox]

; Sub Title
[TextBox]
Pos=POS_SubTitle
Font=F_ApSubTitle
Outline=1,C_ApOutline
Name=APValue3
TextSet=1,CENTER,C_ApSubTitle
[/TextBox]

; Disclaimer
[TextBox]
Pos=POS_CD399Disclaimer
Font=F_CDSmallText
Outline=1,C_ApOutline
Name=APValue4
TextSet=1,LEFT,C_ApSubTitle
[/TextBox]

; F2
[Button]
Act=FSCMD,N,YES
ActKey=F2
Font=F_ApButton
TextID="Yes"
Pos=POS_Button_F2
Picture=I_AP_BUTTON_RIGHT
TextSet=TS_CDButton
[/Button]

; F4
[Button]
Act=FSCMD,N,NO
ActKey=F4
Font=F_ApButton
TextID="No"
Pos=POS_Button_F4
Picture=I_AP_BUTTON_RIGHT
TextSet=TS_CDButton
[/Button]

; F8, CANCEL
[Button]
Act=FSCMD,N,EXIT
ActKey=F8,CANCEL
Font=F_ApButton
TextSet=TS_CDCancelButton
TextID="Exit"
Pos=POS_Button_F8
Picture=I_AP_BUTTON_RED_RIGHT
[/Button]

; Timeover
[Button]
Act=FSCMD,N,TIMEOVER
ActKey=TIMEOVER
[/Button]

[/Screen]

