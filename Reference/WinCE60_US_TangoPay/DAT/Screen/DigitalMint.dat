ID=371
Back=199904

; Screen Title
[TextBox]
Pos=POS_DMScreenTitle
Font=F_DMScreenTitle
TextID=DMEnterPINScreenTitle
TextSet=1,CENTER,C_DMText
[/TextBox]

; Sub Title
[TextBox]
