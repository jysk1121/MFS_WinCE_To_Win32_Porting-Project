;///////////////////////////////
;       DigitalMint Phone
;           370 Screen
;///////////////////////////////
[Screen]
ID=370
Back=199904

; Screen Title
[TextBox]
Pos=POS_DMScreenTitle
Font=F_DMScreenTitle
TextID=DMPhoneNumberScreenTitle
TextSet=1,CENTER,C_DMText
[/TextBox]

; Sub Title
[TextBox]
Pos=POS_DMSubTitle
Font=F_DMSubTitle
TextID=DMPhoneNumberSubtitle
TextSet=1,CENTER,C_DMText
[/TextBox]

; F8, CANCEL
[Button]
Act=FSCMD,N,EXIT
ActKey=F8,CANCEL
Pos=POS_Button_F8
Picture=I_AP_BUTTON_RED_RIGHT
Font=F_ApButton
TextSet=TS_DMCancelButton
TextID="Exit"
[/Button]

; Timeover
[Button]
Act=FSCMD,N,TIMEOVER
ActKey=TIMEOVER
[/Button]

[CustomEditBox]
Act=FSCMD,N,
ActKey=ENTER
AFocus=1
Font=F_ApTitle
MaxInChar=10
DispFormat=NNN-NNN-NNNN
Pos=POS_DMInputBox
TextSet=0,CENTER,C_DMInputText
Picture=I_AP_INPUT_BOX
[/CustomEditBox]

; Under Guide
[TextBox]
Pos=POS_DMHelpText
Name=APValue1
Font=F_DMTextBold
TextSet=1,CENTER,C_DMHelpText
[/TextBox]

[/Screen]

;///////////////////////////////
;        DigitalMint PIN
;           371 Screen
;///////////////////////////////
