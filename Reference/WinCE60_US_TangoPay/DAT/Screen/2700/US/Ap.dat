;///////////////////////////////
;   NOTICE SCREEN
;   30101 Screen
;//////////////////////////////

[Screen]
ID=30101
Back=199900

; Box - Notice Box
[TextBox]
Picture=I_AP_NOTICE_BOX
Pos=6,53,627,372
[/TextBox]

; Title
[TextBox]
Pos=78,92,531,30
Font=F_ApNoticeTitle
Name=APValue1
TextSet=0,LEFT,C_ApNoticeTitle
[/TextBox]

; Message
[TextBox]
Pos=25,222,587,91
Font=F_ApNoticeMsg
Name=APValue2
TextSet=1,LEFT,C_ApNoticeMsg
[/TextBox]

[AdvBox]
Pos=0,0,640,480
Name=APValue1
[/AdvBox]

[/Screen]

