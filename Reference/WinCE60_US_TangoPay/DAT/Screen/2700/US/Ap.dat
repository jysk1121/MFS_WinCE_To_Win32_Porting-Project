ActKey=F4
Pos=POS_Button_F4
Picture=I_AP_BUTTON_RIGHT
Font=F_ApButton
TextSet=0,CENTER,C_ApText
TextID="No"
[/Button]

; CANCEL
[Button]
Act=FSCMD,N,EXIT
ActKey=CANCEL
[/Button]

; Timeover
[Button]
Act=FSCMD,N,TIMEOVER
ActKey=TIMEOVER
[/Button]

[/Screen]


;////////////////////////////
;       420 Screen		(Download App Store - TangoPay)
;////////////////////////////

[Screen]
ID=420
Back=199900

; Sub Title
[TextBox]
Pos=0,40,640,60
Font=F_ApSubTitle
Outline=1,C_ApOutline
TextID="420001"
TextSet=1,CENTER,C_ApSubTitle
[/TextBox]

; QR Code
[TranAdvBox]
Pos=240,110,160,180
[/TranAdvBox]

; App Store image
[TextBox]
Pos=162,290,316,64
Picture=I_AP_TP_APP_STORE
[/TextBox]

; Bottom Messag
[TextBox]
Pos=0,354,640,60
Font=F_ApSubTitle
Outline=1,C_ApOutline
TextID="420002"
TextSet=1,CENTER,C_ApSubTitle
[/TextBox]

; F8, Confirm
[Button]
Act=FSCMD,N,CONFIRM
ActKey=F8
Pos=POS_Button_F8
Picture=I_AP_BUTTON_RIGHT
Font=F_ApButton
TextSet=0,CENTER,C_ApButton
TextID="Confirm"
[/Button]

; CANCEL
[Button]
Act=FSCMD,N,EXIT
ActKey=CANCEL
[/Button]

; Timeover
[Button]
Act=FSCMD,N,TIMEOVER
ActKey=TIMEOVER
[/Button]

[/Screen]



