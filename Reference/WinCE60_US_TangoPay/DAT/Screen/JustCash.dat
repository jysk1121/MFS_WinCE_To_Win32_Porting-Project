[Button]
Act=FSCMD,N,TIMEOVER
ActKey=TIMEOVER
[/Button]

[CustomEditBox]
Act=FSCMD,N,
ActKey=ENTER
AFocus=1
Font=F_ApTitle
MaxInChar=10
DispFormat=NNN-NNN-NNNN
Pos=POS_JCInputBox
TextSet=0,CENTER,C_JCInputText
Picture=I_AP_INPUT_BOX
[/CustomEditBox]

[/Screen]

