;///////////////////////////////
;    Just.Cash Flow Selection
;           500 Screen
;///////////////////////////////
[Screen]
ID=500
Back=199900

; Screen Title
[TextBox]
Pos=POS_JCScreenTitle
Font=F_JCScreenTitle
TextID=JCFlowSelection
TextSet=1,CENTER,C_JCText
Outline=1,C_JCOutline
[/TextBox]

; F2, Bitcoin
[Button]
Act=FSCMD,N,BITCOIN
ActKey=F2
Pos=POS_Button_F2
Picture=I_AP_BUTTON_RIGHT
Font=F_ApButton
TextSet=TS_JCButton
TextID=JCDigitalCurrency
[/Button]

; F4, Cardless
[Button]
Act=FSCMD,N,CARDLESS
ActKey=F4
Pos=POS_Button_F4
Picture=I_AP_BUTTON_RIGHT
Font=F_ApButton
TextSet=TS_JCButton
TextID=JCCardlessTransaction
[/Button]

; F8, CANCEL
[Button]
Act=FSCMD,N,EXIT
ActKey=F8,CANCEL
Pos=POS_Button_F8
Picture=I_AP_BUTTON_RED_RIGHT
Font=F_ApButton
TextSet=TS_JCCancelButton
TextID="Exit"
[/Button]

; Timeover
[Button]
Act=FSCMD,N,TIMEOVER
ActKey=TIMEOVER
[/Button]

[/Screen]

