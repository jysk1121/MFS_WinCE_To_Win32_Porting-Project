;///////////////////////////////
;        Just.Cash Phone
;           505 Screen
;///////////////////////////////
[Screen]
ID=505
Back=199900

; Screen Title
[TextBox]
Pos=POS_JCScreenTitle
Font=F_JCScreenTitle
TextID=JCPhoneNumberScreenTitle
TextSet=1,CENTER,C_JCText
Outline=1,C_JCOutline
[/TextBox]

; Sub Title
[TextBox]
Pos=POS_JCSubTitle
Font=F_JCSubTitle
TextID=JCPhoneNumberSubtitle
TextSet=1,CENTER,C_JCText
Outline=1,C_JCOutline
[/TextBox]

; F8, CANCEL
[Button]
Act=FSCMD,N,EXIT
ActKey=F8,CANCEL
Pos=POS_Button_F8
Picture=I_AP_BUTTON_RED_RIGHT
Font=F_ApButton
TextSet=TS_JCCancelButton
TextID="Exit"
[/Button]

