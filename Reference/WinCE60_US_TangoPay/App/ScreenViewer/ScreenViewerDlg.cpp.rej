-	else if (nLocaleMode == 5)
-		m_pScrCtrl->SetVariable(_T("kindLanguage"), _T("KOREAN"));
-	else if (nLocaleMode == 6)
-		m_pScrCtrl->SetVariable(_T("kindLanguage"), _T("JAPANESE"));
+	// Adjust the width for the vertical scroll bar and the left and right border.
+	dx += ::GetSystemMetrics(SM_CXVSCROLL) + 2 * ::GetSystemMetrics(SM_CXEDGE);
 
+	return dx;
+}
 
